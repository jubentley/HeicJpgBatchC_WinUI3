<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HeicJpgBatchC.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HeicJpgBatchC"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="HeicJpgBatchC">


    <!--Use MainWindow InitializeAcrylic or Window.SystemBackdrop, not both-->

    <!--<Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>-->



    <Grid       
  RowSpacing="12"
  Padding="0">

        <!--<Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#11606070" Offset="0"/>
                <GradientStop Color="#60808090" Offset="0.5"/>
                <GradientStop Color="#90808090" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>-->


        <StackPanel Spacing="12"
        Padding="20"
        VerticalAlignment="Top">

            <!--<Button x:Name="btnBrowse"
            Background="#303040"
            BorderBrush="#606070"
            BorderThickness="1"
            CornerRadius="5"
            Padding="10"
            Content="Browse Directory"
            Click="btnBrowse_Click"/>-->

            <Border Background="#303040"
    BorderBrush="#606070"
    BorderThickness="0"
    CornerRadius="0"
    Padding="20"
    >
                <TextBlock
                    FontSize="20"
           Text="HEIC to JPG Batch Converter"
           TextWrapping="Wrap"/>

            </Border>

            <Border Background="#303040"
    BorderBrush="#606070"
    BorderThickness="0"
    CornerRadius="0"
    Padding="20"
    >
                <TextBlock
           Text="Select a Directory (below), all Images with the .HEIC extension will be copied with the same quality and a .JPG file will be created and placed alongside it."
           TextWrapping="Wrap"/>

            </Border>

            <Border Background="#303040"
    BorderBrush="#606070"
    BorderThickness="1"
    CornerRadius="10"
    Padding="10"
    >

                <TextBlock x:Name="txtDirectory"
                           
           Text="( Click to Select Directory/Folder )"
           TextWrapping="Wrap"
                           PointerPressed="btnBrowse_Click"/>

            </Border>





            <Border Background="#303040"
    BorderBrush="#606070"
    BorderThickness="1"
    CornerRadius="10"
    Padding="10"
                    Width="140"
    >

                <TextBlock x:Name="txtDirectoryb"
     
           Text="Batch Convert"
                           TextAlignment="Center"
           TextWrapping="Wrap"
                           />

            </Border>


            <Border Background="#303040"
    BorderBrush="#606070"
    BorderThickness="0"
    CornerRadius="5"
    Padding="10"
    >
                <TextBlock x:Name="txtDirectoryc"
                           FontStyle="Italic" FontWeight="Bold"
           Text="READY"
           TextWrapping="Wrap"/>

            </Border>

            <Border Background="#303040" HorizontalAlignment="Left"
    BorderBrush="#606070"
    BorderThickness="1"
    CornerRadius="10"
    Padding="10"
                    Width="140"
    >

                <TextBlock 
     
           Text="Exit"
                           TextAlignment="Center"
           TextWrapping="Wrap"
                           />

            </Border>




        </StackPanel>

        <!--<TextBlock x:Name="txtDirectory"
           Grid.Row="1"
           Text="No directory selected"
           TextWrapping="Wrap"/>-->
    </Grid>
</Window>
